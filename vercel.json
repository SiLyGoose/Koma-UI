{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/gear",
      "destination": "/index.html"
    },
    {
      "source": "/gear/",
      "destination": "/index.html"
    },
    {
      "source": "/forge",
      "destination": "/index.html"
    },
    {
      "source": "/forge/",
      "destination": "/index.html"
    },
    {
      "source": "/databank",
      "destination": "/index.html"
    },
    {
      "source": "/databank/",
      "destination": "/index.html"
    }
  ]
}
