{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(kr|technomagic|hero-cuts|built|shared|raid|mines|pinecraft|characters|minesweeper|baccarat|gear/items|gear/classes|gear/slots|forge/sfx|banner/sfx)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/banner",
      "destination": "/shop/wish/"
    },
    {
      "source": "/banner/",
      "destination": "/shop/wish/"
    },
    {
      "source": "/gear",
      "destination": "/player/"
    },
    {
      "source": "/gear/",
      "destination": "/player/"
    }
  ],
  "rewrites": [
    {
      "source": "/player",
      "destination": "/index.html"
    },
    {
      "source": "/player/",
      "destination": "/index.html"
    },
    {
      "source": "/inventory",
      "destination": "/index.html"
    },
    {
      "source": "/inventory/",
      "destination": "/index.html"
    },
    {
      "source": "/inventory/:tab",
      "destination": "/index.html"
    },
    {
      "source": "/inventory/:tab/",
      "destination": "/index.html"
    },
    {
      "source": "/heroes",
      "destination": "/index.html"
    },
    {
      "source": "/heroes/",
      "destination": "/index.html"
    },
    {
      "source": "/forge",
      "destination": "/index.html"
    },
    {
      "source": "/forge/",
      "destination": "/index.html"
    },
    {
      "source": "/shop",
      "destination": "/index.html"
    },
    {
      "source": "/shop/",
      "destination": "/index.html"
    },
    {
      "source": "/shop/:tab",
      "destination": "/index.html"
    },
    {
      "source": "/shop/:tab/",
      "destination": "/index.html"
    },
    {
      "source": "/dressing-room",
      "destination": "/index.html"
    },
    {
      "source": "/hero-outfits",
      "destination": "/index.html"
    },
    {
      "source": "/hero-outfits/",
      "destination": "/index.html"
    },
    {
      "source": "/dressing-room/",
      "destination": "/index.html"
    },
    {
      "source": "/databank",
      "destination": "/index.html"
    },
    {
      "source": "/databank/",
      "destination": "/index.html"
    },
    {
      "source": "/databank/:section",
      "destination": "/index.html"
    },
    {
      "source": "/databank/:section/",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/admin/",
      "destination": "/index.html"
    }
  ]
}
